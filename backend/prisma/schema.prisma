generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// UTILISATEURS & PROFILS
// =============================================

enum Role {
  MEMBRE
  VOLONTAIRE
  PRESIDENT_CERCLE
  RESPONSABLE_ASSO
  MODERATEUR
  ADMIN
}

enum StatutInscription {
  VALIDE
  REFUSE
  SUSPENDU
}

enum SituationActuelle {
  ETUDIANT
  PROFESSIONNEL
  ENTREPRENEUR
  EN_RECHERCHE
}

model User {
  id            String            @id @default(cuid())
  prenom        String?
  nom           String?
  email         String            @unique
  motDePasse    String?
  dateNaissance DateTime?
  role          Role              @default(MEMBRE)
  rolesDelegues UserRoleGrant[]
  jetonsRevoques JetonRevoque[]
  statut        StatutInscription @default(VALIDE)
  emailVerifie  Boolean           @default(false)
  tokenVersion  Int               @default(0)
  /// Dernière activité connue (déconnexion du temps réel, envoi de message).
  derniereActiviteLe DateTime?
  codeVerif     String?
  codeExpire    DateTime?
  cguAccepteLe  DateTime?
  parrainId     String?
  parrain       User?             @relation("Parrainage", fields: [parrainId], references: [id])
  filleuls      User[]            @relation("Parrainage")
  profil        Profil?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model EmailVerification {
  id         String    @id @default(cuid())
  email      String    @unique
  /// Empreinte bcrypt du code (jamais le code en clair).
  code       String
  codeExpire DateTime
  /// Essais de saisie consommés pour le code courant (5 au maximum).
  tentatives Int       @default(0)
  verifieLe  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model PasswordResetCode {
  id         String    @id @default(cuid())
  email      String    @unique
  codeHash   String
  expireLe   DateTime
  tentatives Int       @default(0)
  utiliseLe  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([expireLe])
}

/// Code de connexion sans mot de passe. Seul le hash du code est conservé ;
/// chaque nouvelle demande remplace et invalide la précédente pour l'adresse.
model LoginOtpCode {
  id         String    @id @default(cuid())
  email      String    @unique
  codeHash   String
  expireLe   DateTime
  tentatives Int       @default(0)
  utiliseLe  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([expireLe])
}

model Profil {
  id                  String                   @id @default(cuid())
  userId              String                   @unique
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telephone           String?
  pays                String?
  ville               String?
  situation           SituationActuelle?
  titre               String?
  // `titre` est le titre affiché sous le nom. Tant que `titrePersonnalise` est faux, il est
  // recalculé à partir du parcours (« Poste - Entreprise », « Étudiant(e) - Université »,
  // « Membre du réseau »). Vrai : le membre l'a écrit lui-même et on n'y touche plus.
  titrePersonnalise   Boolean                  @default(false)
  bio                 String?                  @db.Text
  photo               String?                  @db.Text
  photoCouverture     String?                  @db.Text
  linkedin            String?                  @db.VarChar(500)
  facebook            String?                  @db.VarChar(500)
  instagram           String?                  @db.VarChar(500)
  tiktok              String?                  @db.VarChar(500)
  emailVisible        Boolean                  @default(false)
  telephoneVisible    Boolean                  @default(false)
  estVolontaire       Boolean                  @default(false)
  onboardingEtape     Int                      @default(0)
  onboardingFini      Boolean                  @default(false)
  // Copie structurée du questionnaire. Les tables relationnelles restent la
  // source des fonctionnalités du réseau, tandis que ce snapshot conserve les
  // champs purement éditoriaux du formulaire (indicatif, choix « autre »,
  // précisions) afin de pouvoir reprendre l'édition sur un autre appareil.
  onboardingDonnees   Json?
  formations          Formation[]
  experiences         Experience[]
  synergiesEnvoyees   Synergie[]               @relation("Demandeur")
  synergiesRecues     Synergie[]               @relation("Recepteur")
  conversations       ConversationMembre[]
  messages            Message[]
  rdvDemandes         RendezVous[]             @relation("Demandeur")
  volontaire          Volontaire?
  cerclesMembres      CercleMembre[]
  associations        AssociationMembre[]
  associationsProposees AssociationSuggestion[]
  evenements          EvenementParticipant[]
  photosEvenements EvenementPhoto[]
  offres              Offre[]
  offresEnregistrees   OffreEnregistrement[]
  candidaturesOffres   CandidatureOffre[]
  publications        Publication[]
  reactionsPub        ReactionPublication[]
  commentairesPub     CommentairePublication[]
  notificationsRecues Notification[]           @relation("NotificationDestinataire")
  notificationsEmises Notification[]           @relation("NotificationActeur")
  signalements        Signalement[]
  createdAt           DateTime                 @default(now())
}

// =============================================
// FORMATIONS & ÉTABLISSEMENTS
// =============================================

enum TypeEtablissement {
  FONDAMENTALE
  LYCEE
  UNIVERSITE
  ECOLE_SUPERIEURE
}

enum StatutEtablissement {
  PUBLIC
  PRIVE
  INCONNU
}

enum NiveauEducation {
  PRESCOLAIRE
  PRIMAIRE
  FONDAMENTAL
  SECONDAIRE
  PROFESSIONNEL
  SUPERIEUR
  FORMATION_CONTINUE
}

enum TypeProgrammeEducation {
  DOMAINE
  FORMATION
  FILIERE
  SPECIALITE
  PARCOURS
  SERIE
}

enum StatutDiplomeFormation {
  OBTENU
  EN_COURS
  NON_OBTENU
  NON_DIPLOMANTE
}

enum DemarcheApresFormation {
  RECHERCHE_EMPLOI
  POURSUITE_ETUDES
  AUTRE_PROJET
}

enum DelaiPremierEmploi {
  MOINS_3_MOIS
  DE_3_A_6_MOIS
  DE_7_A_12_MOIS
  PLUS_12_MOIS
  MOINS_DE_12_MOIS_DEPUIS_FIN
  PAS_ENCORE
}

enum LienEmploiFormation {
  DIRECT
  PARTIEL
  AUCUN
}

enum ModeUtilisationSource {
  IMPORT_OUVERT
  API_OFFICIELLE
  VALIDATION_SEULE
  REFERENCEMENT
}

enum StatutImportEducation {
  EN_COURS
  TERMINE
  PARTIEL
  ECHEC
}

enum TypeSuggestionCatalogue {
  ETABLISSEMENT
  PROGRAMME
  SPECIALITE
  SERIE
  DIPLOME
}

enum StatutSuggestionCatalogue {
  EN_ATTENTE
  A_VALIDER
  ACCEPTEE
  REFUSEE
  FUSIONNEE
}

model PaysEducation {
  code             String               @id @db.Char(2)
  nom              String
  nomAnglais       String?
  codeIso3         String?              @unique @db.Char(3)
  drapeau          String?
  indicatif        String?
  prioriteDiaspora Int                  @default(999)
  etablissements   Etablissement[]      @relation("PaysEtablissement")
  programmes       ProgrammeEducation[]
  diplomes         DiplomeEducation[]
  sources          SourceEducative[]
  imports          ImportEducation[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Etablissement {
  id                  String                   @id @default(cuid())
  nom                 String
  nomNormalise        String
  sigle               String?
  type                TypeEtablissement
  paysCode            String                   @db.Char(2)
  pays                PaysEducation            @relation("PaysEtablissement", fields: [paysCode], references: [code])
  // Le pays d'implantation et le système scolaire suivi sont deux notions
  // différentes (ex. un lycée français situé au Mali).
  // Code ISO du système national (ML, FR...) ou AUTRE.
  systemeEducatifCode String                   @db.VarChar(16)
  ville               String?
  villeNormalisee     String                   @default("")
  // Détail administratif (Mali : `ville` = chef-lieu de région, le reste ici).
  // `localite` = village ou quartier (ancienne valeur de `ville`).
  localite            String?
  commune             String?
  // P-code COD-AB OCHA (ex. ML090105) ou code provisoire « ML23:… ».
  communeCode         String?                  @db.VarChar(64)
  cercle              String?
  region              String?
  statut              StatutEtablissement      @default(INCONNU)
  habilite            Boolean?
  description         String?
  siteWeb             String?
  latitude            Decimal?                 @db.Decimal(9, 6)
  longitude           Decimal?                 @db.Decimal(9, 6)
  valide              Boolean                  @default(true)
  niveaux             EtablissementNiveau[]
  programmes          EtablissementProgramme[]
  alias               EtablissementAlias[]
  sources             EtablissementSource[]
  formations          Formation[]
  avis                AvisEtablissement[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  // Deux établissements distincts peuvent légitimement porter le même nom dans
  // une même ville. L'unicité repose sur les identifiants de provenance (UAI,
  // ROR, URN…), pas sur un libellé humain.
  @@index([paysCode, nomNormalise, villeNormalisee])
  @@index([paysCode, type, villeNormalisee])
  @@index([paysCode, communeCode])
  @@index([systemeEducatifCode])
  @@index([nomNormalise])
}

model EtablissementNiveau {
  etablissementId String
  etablissement   Etablissement   @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  niveau          NiveauEducation

  @@id([etablissementId, niveau])
  @@index([niveau])
}

model EtablissementAlias {
  id              String        @id @default(cuid())
  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  nom             String
  nomNormalise    String
  langue          String?
  createdAt       DateTime      @default(now())

  @@unique([etablissementId, nomNormalise])
  @@index([nomNormalise])
}

model ProgrammeEducation {
  id                    String                   @id @default(cuid())
  paysCode              String?                  @db.Char(2)
  pays                  PaysEducation?           @relation(fields: [paysCode], references: [code])
  parentId              String?
  parent                ProgrammeEducation?      @relation("HierarchieProgrammes", fields: [parentId], references: [id], onDelete: Cascade)
  enfants               ProgrammeEducation[]     @relation("HierarchieProgrammes")
  nom                   String
  nomNormalise          String
  sigle                 String?
  type                  TypeProgrammeEducation
  niveau                NiveauEducation
  codeOfficiel          String?
  description           String?
  actif                 Boolean                  @default(true)
  etablissements        EtablissementProgramme[]
  sources               ProgrammeSource[]
  formationsPrincipales Formation[]              @relation("FormationProgramme")
  formationsParcours    Formation[]              @relation("FormationParcours")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([paysCode, type, niveau])
  @@index([parentId])
  @@index([nomNormalise])
}

model DiplomeEducation {
  id           String                   @id @default(cuid())
  paysCode     String                   @db.Char(2)
  pays         PaysEducation            @relation(fields: [paysCode], references: [code])
  nom          String
  nomNormalise String
  sigle        String?
  niveau       NiveauEducation
  niveauEntree String?
  niveauSortie String?
  actif        Boolean                  @default(true)
  programmes   EtablissementProgramme[]
  sources      DiplomeSource[]
  formations   Formation[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@unique([paysCode, niveau, nomNormalise])
  @@index([paysCode, niveau])
}

model EtablissementProgramme {
  id              String                 @id @default(cuid())
  etablissementId String
  etablissement   Etablissement          @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  programmeId     String
  programme       ProgrammeEducation     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  diplomeId       String?
  diplome         DiplomeEducation?      @relation(fields: [diplomeId], references: [id])
  niveau          NiveauEducation
  actif           Boolean                @default(true)
  sources         OffreFormationSource[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([etablissementId, programmeId, diplomeId])
  @@index([etablissementId, niveau])
  @@index([programmeId])
}

model SourceEducative {
  id              String                 @id @default(cuid())
  code            String                 @unique
  nom             String
  url             String
  paysCode        String?                @db.Char(2)
  pays            PaysEducation?         @relation(fields: [paysCode], references: [code])
  licence         String?
  conditionsUrl   String?
  modeUtilisation ModeUtilisationSource
  priorite        Int                    @default(100)
  actif           Boolean                @default(true)
  etablissements  EtablissementSource[]
  programmes      ProgrammeSource[]
  diplomes        DiplomeSource[]
  offres          OffreFormationSource[]
  imports         ImportEducation[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model EtablissementSource {
  id                 String          @id @default(cuid())
  etablissementId    String
  etablissement      Etablissement   @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  sourceId           String
  source             SourceEducative @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  identifiantExterne String
  urlSource          String?
  confiance          Float           @default(0.5)
  vuLe               DateTime        @default(now())
  donneesBrutes      Json?

  @@unique([sourceId, identifiantExterne])
  @@index([etablissementId])
}

model ProgrammeSource {
  id                 String             @id @default(cuid())
  programmeId        String
  programme          ProgrammeEducation @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  sourceId           String
  source             SourceEducative    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  identifiantExterne String
  urlSource          String?
  confiance          Float              @default(0.5)
  vuLe               DateTime           @default(now())

  @@unique([sourceId, identifiantExterne])
  @@index([programmeId])
}

model DiplomeSource {
  id                 String           @id @default(cuid())
  diplomeId          String
  diplome            DiplomeEducation @relation(fields: [diplomeId], references: [id], onDelete: Cascade)
  sourceId           String
  source             SourceEducative  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  identifiantExterne String
  urlSource          String?
  confiance          Float            @default(0.5)
  vuLe               DateTime         @default(now())

  @@unique([sourceId, identifiantExterne])
  @@index([diplomeId])
}

model OffreFormationSource {
  id                 String                 @id @default(cuid())
  offreId            String
  offre              EtablissementProgramme @relation(fields: [offreId], references: [id], onDelete: Cascade)
  sourceId           String
  source             SourceEducative        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  identifiantExterne String
  urlSource          String?
  confiance          Float                  @default(0.5)
  vuLe               DateTime               @default(now())

  @@unique([sourceId, identifiantExterne])
  @@index([offreId])
}

model ImportEducation {
  id         String                @id @default(cuid())
  sourceId   String
  source     SourceEducative       @relation(fields: [sourceId], references: [id])
  paysCode   String?               @db.Char(2)
  pays       PaysEducation?        @relation(fields: [paysCode], references: [code])
  statut     StatutImportEducation @default(EN_COURS)
  ajoutes    Int                   @default(0)
  modifies   Int                   @default(0)
  ignores    Int                   @default(0)
  erreurs    Int                   @default(0)
  detail     Json?
  commenceLe DateTime              @default(now())
  termineLe  DateTime?

  @@index([sourceId, paysCode, commenceLe])
}

model SuggestionCatalogue {
  id                  String                            @id @default(cuid())
  type                TypeSuggestionCatalogue
  fingerprint         String
  libelleBrut         String
  libelleNormalise    String
  paysCode            String                            @db.Char(2)
  ville               String?
  villeNormalisee     String                            @default("")
  contexteCle         String                            @default("")
  contexte            Json
  statut              StatutSuggestionCatalogue         @default(EN_ATTENTE)
  nombreContributeurs Int                               @default(0)
  candidatId          String?
  scoreDeterministe   Float?
  decisionIA          Json?
  modeleIA            String?
  versionPrompt       String?
  canoniqueId         String?
  valideParId         String?
  valideLe            DateTime?
  contributions       ContributionSuggestionCatalogue[]
  notification        NotificationAdmin?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  @@unique([type, fingerprint])
  @@index([type, paysCode, villeNormalisee, statut])
  @@index([statut, nombreContributeurs])
}

model ContributionSuggestionCatalogue {
  id             String              @id @default(cuid())
  suggestionId   String
  suggestion     SuggestionCatalogue @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  contributorKey String
  libelleBrut    String
  contexte       Json?
  createdAt      DateTime            @default(now())

  @@unique([suggestionId, contributorKey])
  @@index([contributorKey])
}

model NotificationAdmin {
  id           String              @id @default(cuid())
  type         String
  titre        String
  message      String
  suggestionId String              @unique
  suggestion   SuggestionCatalogue @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  lue          Boolean             @default(false)
  traitee      Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([traitee, createdAt])
}

model Formation {
  id                     String                  @id @default(cuid())
  profilId               String
  profil                 Profil                  @relation(fields: [profilId], references: [id], onDelete: Cascade)
  type                   String
  etablissementId        String?
  etablissement          Etablissement?          @relation(fields: [etablissementId], references: [id])
  programmeReferenceId   String?
  programmeReference     ProgrammeEducation?     @relation("FormationProgramme", fields: [programmeReferenceId], references: [id])
  parcoursReferenceId    String?
  parcoursReference      ProgrammeEducation?     @relation("FormationParcours", fields: [parcoursReferenceId], references: [id])
  diplomeReferenceId     String?
  diplomeReference       DiplomeEducation?       @relation(fields: [diplomeReferenceId], references: [id])
  autreEtablissement     String?
  moisDebut              Int?
  anneeDebut             Int?
  moisFin                Int?
  anneeFin               Int?
  diplome                String?
  systemeEducatifCode     String?                 @db.VarChar(5)
  diplomesScolaires       Json?
  mention                String?
  filiere                String?
  specialite             String?
  serie                  String?
  statutDiplome          StatutDiplomeFormation  @default(OBTENU)
  // Le taux à 12 mois porte sur les membres qui déclarent avoir recherché un
  // emploi. Les poursuites d'études, autres projets et suivis encore trop
  // récents sont exclus du dénominateur.
  demarcheApresFormation DemarcheApresFormation?
  delaiPremierEmploi     DelaiPremierEmploi?
  emploiDansLes12Mois    Boolean?
  lienEmploiFormation    LienEmploiFormation?
  // Conservé pendant la transition des anciennes données.
  enCours                Boolean                 @default(false)
  avis                   AvisEtablissement?

  @@index([programmeReferenceId])
  @@index([parcoursReferenceId])
  @@index([diplomeReferenceId])
}

model AvisEtablissement {
  id                  String        @id @default(cuid())
  formationId         String        @unique
  formation           Formation     @relation(fields: [formationId], references: [id], onDelete: Cascade)
  etablissementId     String
  etablissement       Etablissement @relation(fields: [etablissementId], references: [id])
  noteEnseignement    Int?
  noteContenu         Int?
  noteInfrastructures Int?
  noteInsertion       Int?
  noteAmbiance        Int?
  commentaire         String?
  anneePromo          Int?
  createdAt           DateTime      @default(now())
}

model Experience {
  id          String    @id @default(cuid())
  profilId    String
  profil      Profil    @relation(fields: [profilId], references: [id], onDelete: Cascade)
  poste       String
  entreprise  String
  ville       String?
  pays        String?
  secteur     String?
  typeContrat String?
  dateDebut   DateTime
  dateFin     DateTime?
  estActuel   Boolean   @default(false)
  description String?
}

// =============================================
// SYNERGIES
// =============================================

enum StatutSynergie {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

model Synergie {
  id          String         @id @default(cuid())
  clePaire    String         @unique
  demandeurId String
  demandeur   Profil         @relation("Demandeur", fields: [demandeurId], references: [id])
  recepteurId String
  recepteur   Profil         @relation("Recepteur", fields: [recepteurId], references: [id])
  statut      StatutSynergie @default(EN_ATTENTE)
  raison      String?
  createdAt   DateTime       @default(now())

  @@unique([demandeurId, recepteurId])
}

// =============================================
// MESSAGERIE
// =============================================

model Conversation {
  id               String               @id @default(cuid())
  titre            String?
  estGroupe        Boolean              @default(false)
  cleDirecte       String?              @unique
  dernierMessageLe DateTime?
  participants     ConversationMembre[]
  messages         Message[]
  createdAt        DateTime             @default(now())

  @@index([dernierMessageLe])
}

model ConversationMembre {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  profilId       String
  profil         Profil       @relation(fields: [profilId], references: [id])
  rejointLe      DateTime     @default(now())
  dernierLuLe    DateTime?

  @@id([conversationId, profilId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  auteurId       String
  auteur         Profil       @relation(fields: [auteurId], references: [id])
  contenu        String       @db.Text
  lu             Boolean      @default(false)
  createdAt      DateTime     @default(now())
  piecesJointes  PieceJointeMessage[]
}

/// Fichier joint à un message. Stocké dans un dossier PRIVÉ (hors /uploads),
/// servi uniquement aux membres de la conversation.
model PieceJointeMessage {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Nom d'origine nettoyé, affiché et proposé au téléchargement.
  nom       String   @db.VarChar(200)
  mime      String   @db.VarChar(120)
  taille    Int
  /// Nom du fichier sur disque (aléatoire), relatif au dossier privé.
  fichier   String   @db.VarChar(120)
  createdAt DateTime @default(now())

  @@index([messageId])
}

// =============================================
// MENTORAT / VOLONTAIRES
// =============================================

model Volontaire {
  id               String       @id @default(cuid())
  profilId         String       @unique
  profil           Profil       @relation(fields: [profilId], references: [id], onDelete: Cascade)
  specialite       String
  sujets           Json?
  precisionsSujets Json?
  disponible       Boolean      @default(true)
  fuseau           String       @default("Africa/Bamako")
  dureeCreneau     Int          @default(30)
  format           String?
  dateDebut        DateTime?
  dateFin          DateTime?
  disponibilites   Json?
  maxRdvMois       Int?
  delaiMinResa     Int          @default(24)
  rdvs             RendezVous[]
}

enum StatutRDV {
  EN_ATTENTE
  ACCEPTE
  REFUSE
  ANNULE
}

model RendezVous {
  id             String     @id @default(cuid())
  cleReservation String?    @unique
  volontaireId   String
  volontaire     Volontaire @relation(fields: [volontaireId], references: [id])
  demandeurId    String
  demandeur      Profil     @relation("Demandeur", fields: [demandeurId], references: [id])
  debut          DateTime
  fin            DateTime
  motif          String     @db.Text
  statut         StatutRDV  @default(EN_ATTENTE)
  lienAppel      String?
  createdAt      DateTime   @default(now())

  @@index([volontaireId, debut])
  @@index([demandeurId, debut])
  @@index([statut, debut])
}

// =============================================
// CERCLES
// =============================================

model Cercle {
  id          String           @id @default(cuid())
  nom         String
  theme       String
  description String?          @db.Text
  presidentId String
  actif       Boolean          @default(true)
  membres     CercleMembre[]
  documents   CercleDocument[]
  reunions    CercleReunion[]
  messages    CercleMessage[]
  createdAt   DateTime         @default(now())

  @@index([actif, theme])
  @@index([presidentId])
}

enum StatutMembreCercle {
  EN_ATTENTE
  ACCEPTE
  REFUSE
}

model CercleMembre {
  cercleId   String
  cercle     Cercle             @relation(fields: [cercleId], references: [id])
  profilId   String
  profil     Profil             @relation(fields: [profilId], references: [id])
  statut     StatutMembreCercle @default(EN_ATTENTE)
  motivation String?
  rejointLe  DateTime?

  @@id([cercleId, profilId])
  @@index([profilId, statut])
  @@index([cercleId, statut])
}

model CercleDocument {
  id        String   @id @default(cuid())
  cercleId  String
  cercle    Cercle   @relation(fields: [cercleId], references: [id])
  titre     String
  url       String
  createdAt DateTime @default(now())
}

model CercleReunion {
  id        String   @id @default(cuid())
  cercleId  String
  cercle    Cercle   @relation(fields: [cercleId], references: [id])
  titre     String
  ordreJour String?
  date      DateTime
  lienAppel String?
  createdAt DateTime @default(now())
}

model CercleMessage {
  id        String   @id @default(cuid())
  cercleId  String
  cercle    Cercle   @relation(fields: [cercleId], references: [id])
  auteurId  String
  contenu   String
  createdAt DateTime @default(now())
}

// =============================================
// ÉDUCATION — FORUM
// =============================================

model ForumQuestion {
  id              String         @id @default(cuid())
  auteurId        String
  titre           String
  contenu         String
  secteur         String?
  etablissementId String?
  valide          Boolean        @default(true)
  reponses        ForumReponse[]
  createdAt       DateTime       @default(now())
}

model ForumReponse {
  id          String        @id @default(cuid())
  questionId  String
  question    ForumQuestion @relation(fields: [questionId], references: [id])
  auteurId    String
  contenu     String
  estAcceptee Boolean       @default(false)
  createdAt   DateTime      @default(now())
}

// =============================================
// ASSOCIATIONS
// =============================================

model Association {
  id               String                  @id @default(cuid())
  nom              String
  description      String?                 @db.Text
  pays             String
  ville            String?
  vocation         String?
  site             String?                 @db.Text
  emailContact     String?
  photo            String?                 @db.Text
  photoCouverture  String?                 @db.Text
  dateCreation     DateTime?                @db.Date
  // Identifiant Profil.id contrôlé par le service ; historique sans FK conservé.
  responsableId    String?
  valide           Boolean                 @default(true)
  membres          AssociationMembre[]
  createdAt        DateTime                @default(now())

  @@index([valide, pays, ville])
  @@index([responsableId])
}

enum StatutAffiliation {
  EN_ATTENTE
  VERIFIE
  DECLARE
  REFUSE
}

model AssociationMembre {
  associationId String
  association   Association       @relation(fields: [associationId], references: [id])
  profilId      String
  profil        Profil            @relation(fields: [profilId], references: [id])
  statut        StatutAffiliation @default(EN_ATTENTE)
  rejointLe     DateTime?

  @@id([associationId, profilId])
  @@index([profilId, statut])
  @@index([associationId, statut])
}

enum StatutSuggestionAssociation {
  EN_ATTENTE
  TRAITEE
  REFUSEE
}

model AssociationSuggestion {
  id          String                       @id @default(cuid())
  nom         String
  pays        String
  ville       String?
  vocation    String?
  message     String?                      @db.Text
  proposeurId String
  proposeur   Profil                       @relation(fields: [proposeurId], references: [id], onDelete: Cascade)
  statut      StatutSuggestionAssociation   @default(EN_ATTENTE)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([statut, createdAt])
  @@index([proposeurId, createdAt])
}

// =============================================
// ÉVÉNEMENTS
// =============================================

model Evenement {
  id             String                 @id @default(cuid())
  titre          String
  description    String                 @db.Text
  type           String
  lieu           String?
  lienVideo      String?                @db.Text
  dateDebut      DateTime
  dateFin        DateTime?
  capacite       Int?
  organisateurId String
  valide         Boolean                @default(false)
  pays             String?
  ville            String?
  fuseauHoraire    String?
  photoCouverture  String? @db.Text
  programme        Json?
  resume           String? @db.Text
  refuse           Boolean @default(false)
  photos           EvenementPhoto[]
  participants   EvenementParticipant[]
  createdAt      DateTime               @default(now())

  @@index([valide, dateDebut])
  @@index([organisateurId])
  @@index([valide, refuse, dateDebut])
  @@index([pays, ville])
}

model EvenementParticipant {
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id])
  profilId    String
  profil      Profil    @relation(fields: [profilId], references: [id])
  inscritLe   DateTime  @default(now())

  @@id([evenementId, profilId])
  @@index([profilId, inscritLe])
}

// =============================================
// OFFRES D'EMPLOI
// =============================================

model Offre {
  id              String    @id @default(cuid())
  titre           String
  entreprise      String
  type            String
  secteur         String
  pays            String
  ville           String?
  teletravail     Boolean   @default(false)
  description     String    @db.Text
  lienCandidature String?   @db.Text
  emailContact    String?
  dateExpiration  DateTime?
  publieurId      String
  publieur        Profil    @relation(fields: [publieurId], references: [id])
  valide          Boolean   @default(false)
  statutModeration StatutModerationOffre @default(EN_ATTENTE)
  modeTravail      ModeTravailOffre @default(SUR_SITE)
  modeCandidature  ModeCandidatureOffre @default(MALI_WULI)
  salaire         String?
  profilRecherche String? @db.Text
  recommandationPossible Boolean @default(false)
  enregistrements OffreEnregistrement[]
  candidatures    CandidatureOffre[]
  createdAt       DateTime  @default(now())

  @@index([valide, dateExpiration, createdAt])
  @@index([publieurId, createdAt])
  @@index([type, secteur, pays])
  @@index([statutModeration, dateExpiration, createdAt])
  @@index([modeTravail, pays, ville])
}

// =============================================
// FIL D'ACTUALITE
// =============================================

enum IntentionPublication {
  OFFRE
  DEMANDE
}

enum TypePublication {
  TEXTE
  PHOTO
  LIEN
  EVENEMENT
}

enum TypeReaction {
  LIKE
  BRAVO
  SOUTIEN
  INSTRUCTIF
  INSPIRANT
}

model Publication {
  id           String                   @id @default(cuid())
  auteurId     String
  auteur       Profil                   @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  intention    IntentionPublication
  thematique   String
  type         TypePublication          @default(TEXTE)
  contenu      String                   @db.Text
  photoUrl     String?                  @db.Text
  lienUrl      String?                  @db.Text
  lienTitre    String?
  lienImage    String?                  @db.Text
  epingle      Boolean                  @default(false)
  visible      Boolean                  @default(true)
  // Corbeille : suppression logique, effacement définitif après 30 jours.
  deletedAt    DateTime?
  // Profil.id de la personne qui a supprimé (auteur ou modération), sans FK.
  deletedById  String?
  reactions    ReactionPublication[]
  commentaires CommentairePublication[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([auteurId, createdAt])
  @@index([intention, thematique, createdAt])
  @@index([visible, createdAt])
  @@index([deletedAt])
  @@index([auteurId, deletedAt])
}

model ReactionPublication {
  id            String       @id @default(cuid())
  publicationId String
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  auteurId      String
  auteur        Profil       @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  type          TypeReaction @default(LIKE)
  createdAt     DateTime     @default(now())

  @@unique([publicationId, auteurId])
  @@index([publicationId])
  @@index([auteurId])
}

model CommentairePublication {
  id            String                   @id @default(cuid())
  publicationId String
  publication   Publication              @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  auteurId      String
  auteur        Profil                   @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  contenu       String                   @db.Text
  parentId      String?
  parent        CommentairePublication?  @relation("ReponsesCommentaire", fields: [parentId], references: [id], onDelete: Cascade)
  reponses      CommentairePublication[] @relation("ReponsesCommentaire")
  // Corbeille : suppression logique, effacement définitif après 30 jours.
  deletedAt     DateTime?
  // Profil.id de la personne qui a supprimé (auteur, auteur du post ou modération), sans FK.
  deletedById   String?
  createdAt     DateTime                 @default(now())

  @@index([publicationId, createdAt])
  @@index([auteurId])
  @@index([parentId])
  @@index([deletedAt])
  @@index([auteurId, deletedAt])
}

// =============================================
// NOTIFICATIONS MEMBRES
// =============================================

enum TypeNotification {
  NOUVEAU_MESSAGE
  DEMANDE_SYNERGIE
  SYNERGIE_ACCEPTEE
  SYNERGIE_REFUSEE
  NOUVELLE_PUBLICATION
  NOUVEAU_COMMENTAIRE
  NOUVELLE_REPONSE
  NOUVELLE_REACTION
  RENDEZ_VOUS
  EVENEMENT
  OFFRE
  CERCLE
  SIGNALEMENT
}

model Notification {
  id             String           @id @default(cuid())
  destinataireId String
  destinataire   Profil           @relation("NotificationDestinataire", fields: [destinataireId], references: [id], onDelete: Cascade)
  acteurId       String?
  acteur         Profil?          @relation("NotificationActeur", fields: [acteurId], references: [id], onDelete: SetNull)
  type           TypeNotification
  titre          String
  detail         String?          @db.Text
  href           String?          @db.Text
  payload        Json?
  lue            Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([destinataireId, lue, createdAt])
  @@index([acteurId])
}

// =============================================
// SIGNALEMENTS
// =============================================

enum StatutSignalement {
  EN_ATTENTE
  EN_COURS
  TRAITE
  REJETE
}

model Signalement {
  id          String            @id @default(cuid())
  signaleurId String
  signaleur   Profil            @relation(fields: [signaleurId], references: [id])
  // PUBLICATION, COMMENTAIRE, PROFIL, ASSOCIATION, ETABLISSEMENT, EVENEMENT, OFFRE, MESSAGE (contrôlé par le serveur).
  cibleType   String
  cibleId     String
  // SPAM, HARCELEMENT, CONTENU_INAPPROPRIE, FAUSSE_INFORMATION, USURPATION, AUTRE (contrôlé par le serveur).
  motif       String
  details     String?           @db.Text
  statut      StatutSignalement @default(EN_ATTENTE)
  // Compatibilité : vrai si et seulement si statut ∈ {TRAITE, REJETE}.
  traite      Boolean           @default(false)
  noteInterne String?           @db.Text
  // User.id de la personne qui a pris en charge ou clos le signalement, sans FK.
  traiteParId String?
  traiteLe    DateTime?
  createdAt   DateTime          @default(now())

  @@index([statut, createdAt])
  @@index([cibleType, cibleId])
  @@index([signaleurId, createdAt])
}

// =============================================
// ANNONCES ADMIN
// =============================================

model Annonce {
  id        String   @id @default(cuid())
  titre     String
  contenu   String
  epingle   Boolean  @default(false)
  auteurId  String
  createdAt DateTime @default(now())
}

model EvenementPhoto {
  id          String   @id @default(cuid())
  evenementId String
  evenement   Evenement @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  auteurId    String
  auteur      Profil   @relation(fields: [auteurId], references: [id])
  url         String   @db.Text
  legende     String?  @db.VarChar(300)
  createdAt   DateTime @default(now())

  @@index([evenementId, createdAt])
  @@index([auteurId])
}

// Suivi des candidatures : la réservation unique précède tout effet externe.
enum StatutModerationOffre {
  EN_ATTENTE
  PUBLIEE
  REFUSEE
}
enum ModeTravailOffre {
  SUR_SITE
  HYBRIDE
  TELETRAVAIL
}
enum ModeCandidatureOffre {
  MALI_WULI
  EMAIL
  LIEN_EXTERNE
}
enum StatutCandidatureOffre {
  EN_COURS
  ENVOYEE
  ECHEC
}
model OffreEnregistrement {
  offreId String
  offre Offre @relation(fields: [offreId], references: [id], onDelete: Cascade)
  profilId String
  profil Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([offreId, profilId])
  @@index([profilId, createdAt])
}
model CandidatureOffre {
  id String @id @default(cuid())
  offreId String
  offre Offre @relation(fields: [offreId], references: [id], onDelete: Cascade)
  profilId String
  profil Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
  modeCandidature ModeCandidatureOffre
  statut StatutCandidatureOffre @default(EN_COURS)
  message String? @db.Text
  conversationId String?
  messageId String?
  tentativeId String @unique
  tentatives Int @default(1)
  erreurCode String?
  envoyeeAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([offreId, profilId])
  @@index([profilId, createdAt])
  @@index([offreId, statut])
}

// Droits de domaines cumulables ; codes contrôlés par le registre serveur.
model UserRoleGrant {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  code String
  createdAt DateTime @default(now())

  @@id([userId, code])
  @@index([code])
}

/// Sessions révoquées avant leur expiration (déconnexion d'un appareil).
/// Une ligne par jeton (jti) ; inutile après `expireLe`, purgée régulièrement.
model JetonRevoque {
  jti       String   @id @db.VarChar(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expireLe  DateTime
  createdAt DateTime @default(now())

  @@index([expireLe])
  @@index([userId])
}
