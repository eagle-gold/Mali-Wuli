# Base de données MySQL
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Authentification
JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"
# Liste d'adresses séparées par des virgules. Laisser vide si aucun compte ne
# doit recevoir automatiquement le rôle ADMIN à son inscription.
ADMIN_EMAILS=
# Connexion publique par mot de passe, en complement de l'OTP.
ENABLE_PASSWORD_LOGIN=true
# Limites d'envoi assouplies pour les tests, avec un garde-fou anti-boucle.
AUTH_RATE_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=120
AUTH_CODE_RATE_WINDOW_SECONDS=60
AUTH_CODE_RATE_LIMIT=12
LOGIN_OTP_RATE_WINDOW_SECONDS=60
LOGIN_OTP_RATE_LIMIT=10
LOGIN_OTP_COOLDOWN_SECONDS=5

# Serveur et origine frontend autorisée par CORS
NODE_ENV=development
HOST=0.0.0.0
PORT=8002
FRONTEND_URL=http://localhost:3000

# Stockage persistant des images chargées
UPLOAD_DIR=./uploads

# E-mail : SMTP si configuré, sinon sendmail sur l'hébergement
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SENDMAIL_PATH=/usr/sbin/sendmail
# Réservé aux tests automatisés : ne pas activer en production.
MAIL_DISABLED=false

# Déduplication assistée du catalogue éducatif (facultatif)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
