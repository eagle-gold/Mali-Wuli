  "create": [
    {
      "Table": "Evenement",
      "Create Table": "CREATE TABLE `Evenement` (\n  `id` varchar(191) NOT NULL,\n  `titre` varchar(191) NOT NULL,\n  `description` text NOT NULL,\n  `type` varchar(191) NOT NULL,\n  `lieu` varchar(191) DEFAULT NULL,\n  `lienVideo` text DEFAULT NULL,\n  `dateDebut` datetime(3) NOT NULL,\n  `dateFin` datetime(3) DEFAULT NULL,\n  `capacite` int(11) DEFAULT NULL,\n  `organisateurId` varchar(191) NOT NULL,\n  `valide` tinyint(1) NOT NULL DEFAULT 0,\n  `createdAt` datetime(3) NOT NULL DEFAULT current_timestamp(3),\n  `fuseauHoraire` varchar(191) DEFAULT NULL,\n  `pays` varchar(191) DEFAULT NULL,\n  `photoCouverture` text DEFAULT NULL,\n  `programme` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_bin DEFAULT NULL CHECK (json_valid(`programme`)),\n  `refuse` tinyint(1) NOT NULL DEFAULT 0,\n  `resume` text DEFAULT NULL,\n  `ville` varchar(191) DEFAULT NULL,\n  PRIMARY KEY (`id`),\n  KEY `Evenement_valide_dateDebut_idx` (`valide`,`dateDebut`),\n  KEY `Evenement_organisateurId_idx` (`organisateurId`),\n  KEY `Evenement_valide_refuse_dateDebut_idx` (`valide`,`refuse`,`dateDebut`),\n  KEY `Evenement_pays_ville_idx` (`pays`,`ville`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci"
    }
